# ---------------------------------------------------------------------------
# Analytics dashboard (/dashboard)
#
# Everything here is optional: with none of it set the site builds and runs
# exactly as before, and /dashboard refuses access rather than exposing itself.
# ---------------------------------------------------------------------------

# The ONLY variable sent to the browser, and the only one that collects data.
# Until this is set, nothing is being measured and the dashboard has no history
# to show. GA4 -> Admin -> Data streams.
NEXT_PUBLIC_GA_ID=

# Read access for the dashboard. Server-side only.
# GA4 -> Admin -> Property details (numeric, NOT the G- id).
GA4_PROPERTY_ID=

# Exactly as Search Console lists the property:
#   https://bwmetroproperties.com/      (URL-prefix property)
#   sc-domain:bwmetroproperties.com     (domain property)
GSC_SITE_URL=

# Service account with Viewer on the GA4 property and a user on the Search
# Console property. From its JSON key file.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the quotes and the literal \n escapes.
GOOGLE_PRIVATE_KEY=""

# Password for /dashboard. If this is unset the route is refused outright -
# it never falls open.
DASHBOARD_PASSWORD=

# ---------------------------------------------------------------------------
# Home search (/properties)
# ---------------------------------------------------------------------------

# IDX Broker API key: IDX Broker -> Home -> Access Control -> API Key.
# Server-side only. Without it /properties shows no listings but the
# "Search My Full MLS" button still works.
IDX_BROKER_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Lead forms (/api/lead)
#
# Every form on the site posts to /api/lead, which creates the lead in Follow
# Up Boss and emails Brandon a copy. A submission succeeds when either works.
# ---------------------------------------------------------------------------

# Follow Up Boss -> Admin -> API. Server-side only.
FUB_API_KEY=

# Email copy of each lead, sent with Resend (resend.com -> API Keys).
# Without a verified domain, Resend only sends to the Resend account's own
# address, so sign up with brandon@bwmetroproperties.com.
RESEND_API_KEY=
# Optional overrides. FROM must be on a domain verified in Resend.
# LEAD_EMAIL_TO=brandon@bwmetroproperties.com
# LEAD_EMAIL_FROM=BW Metro Website <leads@bwmetroproperties.com>

# "on" starts one of Brandon's FUB action plans for each brand-new website lead
# (sellers: Seller - Home Evaluation Request, buyers: Buyer New Lead Website
# Registration, others: Web Inquiry Option 01). Leave off if FUB's Lead Flow
# already starts a plan for the bwmetroproperties.com source.
# FUB_ACTION_PLANS=on
